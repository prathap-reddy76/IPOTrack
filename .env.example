# ╔══════════════════════════════════════════════════════════╗
# ║              IPOTrack — Environment Variables            ║
# ╚══════════════════════════════════════════════════════════╝
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Authentication ─────────────────────────────────────────
# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=generate-a-random-secret-here

# NextAuth URL (your app's base URL)
NEXTAUTH_URL=http://localhost:3000

# ── Data Provider Configuration ────────────────────────────
#
# DATA_MODE controls whether the app uses real providers or demo data:
#   demo (default) — reads existing database, no external API calls
#   live — requires provider credentials, fails clearly if missing
DATA_MODE=demo

# IPO Data Provider (currently supported: upstox)
# IPO_DATA_PROVIDER=upstox

# ── Upstox API ─────────────────────────────────────────────
#
# Upstox Developer API v2 — https://upstox.com/developer/api-documentation
#
# TWO token options:
#
# 1. Analytics Token (RECOMMENDED for IPOTrack)
#    - Read-only, valid for 1 year
#    - Generate from Upstox Developer Console → your app → Analytics Token
#    - Does NOT require daily re-authentication
#    - Cannot place orders (not needed for IPOTrack)
#
# 2. OAuth Access Token
#    - Full access, expires daily at 3:30 AM IST
#    - Requires daily OAuth flow to refresh
#    - Only needed if you want order placement (not required)
#
# UPSTOX_ACCESS_TOKEN=

# ── ipoalerts.in GMP Provider ─────────────────────────────
#
# ipoalerts.in API — https://ipoalerts.in
#
# Authentication: x-api-key header
# Free tier: basic IPO data
# Pro plan: GMP data addon (required for grey market premium)
#
# Register at ipoalerts.in → Dashboard → API Keys → Create Key
#
# IPOALERTS_API_KEY=

# ── Cron / Scheduled Sync ─────────────────────────────────
#
# Secret to protect the /api/cron/sync endpoint
# Generate with: openssl rand -hex 32
#
# CRON_SECRET=

# ── Vercel Cron (Optional) ────────────────────────────────
#
# If deploying to Vercel, add crons to vercel.json:
# {
#   "crons": [
#     { "path": "/api/cron/sync?type=GMP", "schedule": "*/30 * * * *" },
#     { "path": "/api/cron/sync?type=IPO", "schedule": "0 */6 * * *" },
#     { "path": "/api/cron/sync?type=SUBSCRIPTION", "schedule": "*/15 * * * *" },
#     { "path": "/api/cron/sync?type=LISTING", "schedule": "0 */2 * * *" }
#   ]
# }
